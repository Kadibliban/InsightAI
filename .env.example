# Copy this file to .env and keep it private.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Safe local default. Set a private PostgreSQL URL in .env when PostgreSQL is configured.
DATABASE_URL=sqlite:///./insightai.db

# Docker Compose settings. Set a unique password before running the container stack.
POSTGRES_DB=insightai
POSTGRES_USER=insightai
POSTGRES_PASSWORD=
API_PORT=8000
DASHBOARD_PORT=8501
